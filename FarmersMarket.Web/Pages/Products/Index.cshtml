@page "/Products"
@model FarmersMarket.Web.Pages.Products.IndexModel

@{
    ViewData["Title"] = "Products";
}

<div class="page-heading mb-4">
    <h1>Search Products</h1>
    <p class="text-muted mb-0">
        Find products and see the vendors and markets where they are available.</p>
</div>

<section class="card search-card mb-4" aria-labelledby="product-search-heading">
    <div class="card-body p-3 p-md-4">
        <h2 id="product-search-heading" class="h5">Find a product</h2>

        <form method="get" id="productSearchForm">
            <label for="searchTerm" class="form-label">Product name</label>

            <div class="input-group">
                <div class="autocomplete-container position-relative flex-grow-1">
                    <input type="text"
                           id="searchTerm"
                           class="form-control"
                           name="searchTerm"
                           value="@Model.SearchTerm"
                           placeholder="Start typing a product name..."
                           autocomplete="off"
                           role="combobox"
                           aria-autocomplete="list"
                           aria-expanded="false"
                           aria-controls="productSuggestions"
                           data-suggestions-url="@Url.Page("/Products/Index", "Suggestions")" />

                    <div id="productSuggestions"
                         class="product-suggestions"
                         role="listbox"
                         hidden>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">
                    Search
                </button>

                @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                {
                    <button type="button"
                            class="btn btn-outline-secondary"
                            onclick="window.location.href='/Products'">
                        Clear Search
                    </button>
                }
            </div>
        </form>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        @Model.ErrorMessage
    </div>
}
else if (Model.Products.Count == 0)
{
    <div class="alert alert-light border" role="status">
        No products matched your search.
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Product</th>
                        <th scope="col">Type</th>
                        <th scope="col">Vendor</th>
                        <th scope="col">Market</th>
                        <th scope="col">Price</th>
                        <th scope="col">Inventory</th>
                        <th scope="col">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var product in Model.Products)
                    {
                        <tr>
                            <th scope="row">@product.ProductName</th>

                            <td>
                                @(string.IsNullOrWhiteSpace(product.ProductType)
                                    ? "Not listed"
                                    : product.ProductType)
                            </td>

                            <td>@product.VendorName</td>
                            <td>@product.MarketName</td>
                            <td>@product.UnitPrice.ToString("C")</td>

                            <td>
                                @if (product.InventoryQuantity == 0)
                                {
                                    <span class="badge inventory-badge-out">
                                        Out of stock
                                    </span>
                                }
                                else
                                {
                                    <span class="badge inventory-badge-in">
                                        @product.InventoryQuantity available
                                    </span>
                                }
                            </td>

                            <td>
                                @if (product.InventoryQuantity > 0)
                                {
                                    <a asp-page="/Preorders/Create"
                                       asp-route-listingSelection="@(product.MarketId + "|" + product.VendorId + "|" + product.ProductId)"
                                       class="btn btn-sm btn-primary">
                                        Preorder
                                    </a>
                                }
                                else
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-secondary"
                                            disabled>
                                        Unavailable
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<style>
    .autocomplete-container {
        min-width: 0;
    }

    .autocomplete-container input {
        width: 100%;
    }

    .product-suggestions {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 1050;
        max-height: 260px;
        overflow-y: auto;
        background: white;
        border: 1px solid #ced4da;
        border-top: none;
        border-radius: 0 0 6px 6px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.12);
    }

    .product-suggestions[hidden] {
        display: none;
    }

    .product-suggestion-item {
        display: block;
        width: 100%;
        padding: 10px 14px;
        border: none;
        border-bottom: 1px solid #eeeeee;
        background: white;
        color: #212529;
        text-align: left;
        cursor: pointer;
    }

    .product-suggestion-item:last-child {
        border-bottom: none;
    }

    .product-suggestion-item:hover,
    .product-suggestion-item.active {
        background: #f0f5f1;
        color: #285c42;
    }

    .product-suggestion-item:focus {
        outline: 2px solid #285c42;
        outline-offset: -2px;
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("searchTerm");
        const searchForm = document.getElementById("productSearchForm");
        const suggestionsBox = document.getElementById("productSuggestions");

        if (!searchInput || !searchForm || !suggestionsBox) {
            return;
        }

        const suggestionsUrl = searchInput.dataset.suggestionsUrl;

        let debounceTimer;
        let activeIndex = -1;
        let currentSuggestions = [];

        function closeSuggestions() {
            suggestionsBox.hidden = true;
            searchInput.setAttribute("aria-expanded", "false");
            searchInput.removeAttribute("aria-activedescendant");
            activeIndex = -1;
        }

        function selectSuggestion(value) {
            searchInput.value = value;
            closeSuggestions();
            searchForm.requestSubmit();
        }

        function renderSuggestions(products) {
            suggestionsBox.innerHTML = "";
            currentSuggestions = products;
            activeIndex = -1;

            if (!products || products.length === 0) {
                closeSuggestions();
                return;
            }

            products.forEach(function (product, index) {
                const option = document.createElement("button");

                option.type = "button";
                option.className = "product-suggestion-item";
                option.id = "product-suggestion-" + index;
                option.setAttribute("role", "option");
                option.setAttribute("aria-selected", "false");
                option.textContent = product;

                option.addEventListener("mousedown", function (event) {
                    event.preventDefault();
                    selectSuggestion(product);
                });

                suggestionsBox.appendChild(option);
            });

            suggestionsBox.hidden = false;
            searchInput.setAttribute("aria-expanded", "true");
        }

        async function loadSuggestions(term) {
            try {
                const url = suggestionsUrl +
                    "&term=" + encodeURIComponent(term);

                const response = await fetch(url, {
                    headers: {
                        "Accept": "application/json"
                    }
                });

                if (!response.ok) {
                    closeSuggestions();
                    return;
                }

                const products = await response.json();

                // Ignore results if the customer has already changed the search.
                if (searchInput.value.trim() !== term) {
                    return;
                }

                renderSuggestions(products);
            }
            catch (error) {
                console.error("Could not load product suggestions:", error);
                closeSuggestions();
            }
        }

        function updateActiveSuggestion(index) {
            const options = suggestionsBox.querySelectorAll(
                ".product-suggestion-item"
            );

            options.forEach(function (option, i) {
                const isActive = i === index;

                option.classList.toggle("active", isActive);
                option.setAttribute("aria-selected", isActive.toString());
            });

            activeIndex = index;

            if (activeIndex >= 0 && options[activeIndex]) {
                searchInput.setAttribute(
                    "aria-activedescendant",
                    options[activeIndex].id
                );

                options[activeIndex].scrollIntoView({
                    block: "nearest"
                });
            }
            else {
                searchInput.removeAttribute("aria-activedescendant");
            }
        }

        searchInput.addEventListener("input", function () {
            const term = searchInput.value.trim();

            clearTimeout(debounceTimer);

            if (term.length < 1) {
                closeSuggestions();
                return;
            }

            debounceTimer = setTimeout(function () {
                loadSuggestions(term);
            }, 200);
        });

        searchInput.addEventListener("keydown", function (event) {
            if (suggestionsBox.hidden) {
                return;
            }

            if (event.key === "ArrowDown") {
                event.preventDefault();

                const nextIndex = Math.min(
                    activeIndex + 1,
                    currentSuggestions.length - 1
                );

                updateActiveSuggestion(nextIndex);
            }
            else if (event.key === "ArrowUp") {
                event.preventDefault();

                const previousIndex = Math.max(activeIndex - 1, 0);

                updateActiveSuggestion(previousIndex);
            }
            else if (event.key === "Enter" && activeIndex >= 0) {
                event.preventDefault();
                selectSuggestion(currentSuggestions[activeIndex]);
            }
            else if (event.key === "Escape") {
                closeSuggestions();
            }
        });

        document.addEventListener("click", function (event) {
            if (!searchForm.contains(event.target)) {
                closeSuggestions();
            }
        });
    });
</script>
