@page "/Products"
@model FarmersMarket.Web.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Products";
}

<div class="page-heading mb-4">
    <h1>Search Products</h1>
    <p class="text-muted mb-0">Find products and see the vendors and markets where they are available.</p>
</div>

<section class="card search-card mb-4" aria-labelledby="product-search-heading">
    <div class="card-body p-3 p-md-4">
        <h2 id="product-search-heading" class="h5">Find a product</h2>
        <form method="get">
            <label for="searchTerm" class="form-label">Product name</label>
            <div class="input-group">
                <input type="text"
                       id="searchTerm"
                       class="form-control"
                       name="searchTerm"
                       value="@Model.SearchTerm"
                       placeholder="For example, honey" />
                <button type="submit" class="btn btn-primary">Search</button>
                @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                {
                    <a class="btn btn-outline-secondary" asp-page="/Products">Clear Search</a>
                }
            </div>
        </form>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        @Model.ErrorMessage
    </div>
}
else if (Model.Products.Count == 0)
{
    <div class="alert alert-light border" role="status">No products matched your search.</div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Product</th>
                        <th scope="col">Type</th>
                        <th scope="col">Vendor</th>
                        <th scope="col">Market</th>
                        <th scope="col">Price</th>
                        <th scope="col">Inventory</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model.Products)
                    {
                        <tr>
                            <th scope="row">@product.ProductName</th>
                            <td>@(string.IsNullOrWhiteSpace(product.ProductType) ? "Not listed" : product.ProductType)</td>
                            <td>@product.VendorName</td>
                            <td>@product.MarketName</td>
                            <td>@product.UnitPrice.ToString("C")</td>
                            <td>
                                @if (product.InventoryQuantity == 0)
                                {
                                    <span class="badge inventory-badge-out">Out of stock</span>
                                }
                                else
                                {
                                    <span class="badge inventory-badge-in">@product.InventoryQuantity available</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
