@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<section class="home-intro text-center rounded-3 p-4 p-md-5 mb-5">
    <h1 class="display-4">Farmers Market Pre-Order</h1>
    <p class="lead">
        Browse farmers markets and their vendors, search products across markets,
        and place a preorder for pickup.
    </p>
</section>

<div class="row g-4">
    <div class="col-md-4">
        <section class="card action-card h-100">
            <div class="card-body d-flex flex-column p-4">
                <h2 class="card-title h4">Browse Markets</h2>
                <p class="card-text">Explore local markets, their locations, hours, and attending vendors.</p>
                <a class="btn btn-primary mt-auto align-self-start" asp-page="/Markets/Index">Browse Markets</a>
            </div>
        </section>
    </div>
    <div class="col-md-4">
        <section class="card action-card h-100">
            <div class="card-body d-flex flex-column p-4">
                <h2 class="card-title h4">Search Products</h2>
                <p class="card-text">Find products and see which vendors offer them at each market.</p>
                <a class="btn btn-primary mt-auto align-self-start" asp-page="/Products/Index">Search Products</a>
            </div>
        </section>
    </div>
    <div class="col-md-4">
        <section class="card action-card h-100">
            <div class="card-body d-flex flex-column p-4">
                <h2 class="card-title h4">Place a Preorder</h2>
                <p class="card-text">Choose an available product and arrange to pick it up at a market.</p>
                <a class="btn btn-primary mt-auto align-self-start" asp-page="/Preorders/Create">Place a Preorder</a>
            </div>
        </section>
    </div>
</div>
